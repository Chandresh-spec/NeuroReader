# Django Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=False

# HuggingFace API Configuration (For text simplification, structuring, etc.)
# The application checks for these in order: HF_API_KEY, HUGGINGFACE_KEY, HUGGINGFACE_TOKEN
HF_API_KEY=your_huggingface_api_token_here

# Google OAuth Configuration (Optional, if using Google login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
